rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Cualquiera puede LEER negocios y productos (para la tienda pública).
    // Solo el dueño autenticado puede crear/editar/borrar su propio negocio.
    match /businesses/{businessId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
    }

    // Productos: lectura pública, escritura solo si el dueño del negocio
    // relacionado coincide con el usuario autenticado.
    match /products/{productId} {
      allow read: if true;
      allow create, update: if request.auth != null &&
        get(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)).data.ownerId == request.auth.uid;
      allow delete: if request.auth != null &&
        get(/databases/$(database)/documents/businesses/$(resource.data.businessId)).data.ownerId == request.auth.uid;
    }

    // Categorías: lectura pública (para la tienda), escritura solo del dueño del negocio.
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update: if request.auth != null &&
        get(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)).data.ownerId == request.auth.uid;
      allow delete: if request.auth != null &&
        get(/databases/$(database)/documents/businesses/$(resource.data.businessId)).data.ownerId == request.auth.uid;
    }

    // Pedidos: cualquier cliente (sin cuenta) puede crear un pedido desde la
    // tienda pública al hacer checkout. Solo el dueño del negocio puede leer
    // o actualizar el estado de sus propios pedidos. No se permite borrar.
    match /orders/{orderId} {
      allow create: if true;
      allow read, update: if request.auth != null &&
        get(/databases/$(database)/documents/businesses/$(resource.data.businessId)).data.ownerId == request.auth.uid;
      allow delete: if false;
    }

    // Eventos de analítica (visitas a la tienda, vistas de producto):
    // cualquier visitante puede generar uno, solo el dueño puede leerlos.
    match /events/{eventId} {
      allow create: if true;
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/businesses/$(resource.data.businessId)).data.ownerId == request.auth.uid;
      allow update, delete: if false;
    }

    // Cupones: lectura pública (para validar el código al pagar). Solo el
    // dueño puede crear/editar/borrar. Excepción acotada: cualquier cliente
    // puede incrementar el contador de usos en 1 al usar un cupón, pero no
    // puede tocar ningún otro campo (evita que alguien manipule el descuento).
    match /coupons/{couponId} {
      allow read: if true;
      allow create: if request.auth != null &&
        get(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)).data.ownerId == request.auth.uid;
      allow delete: if request.auth != null &&
        get(/databases/$(database)/documents/businesses/$(resource.data.businessId)).data.ownerId == request.auth.uid;
      allow update: if
        (request.auth != null &&
          get(/databases/$(database)/documents/businesses/$(resource.data.businessId)).data.ownerId == request.auth.uid) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usageCount']) &&
          request.resource.data.usageCount == resource.data.usageCount + 1);
    }
  }
}
